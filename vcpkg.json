{
    "name": "neko2",
    "version-string": "1.0",
    "dependencies": [
        {
            "name": "sdl2",
            "features": ["vulkan"]
        }, "glm", "glew", "stb", "fmt", 
        {
            "name": "ktx",
            "features": ["tools"]
        },
        {
            "name": "imgui",
            "features": ["sdl2-binding", "opengl3-binding", "docking-experimental", "vulkan-binding"]
        },
        "physfs", "protobuf", "spdlog", "nlohmann-json", "vulkan-memory-allocator", "assimp", "zstd", "argh",
        "spirv-cross", "volk"
    ],
    "features":
    {
        "profiling": {"description": "Profiling", "dependencies": ["tracy"] }
    },
    "builtin-baseline": "89f00b3b8611028566a5264afce725cdfdfddbb4",
    "overrides": [
        { 
            "name": "ktx", 
            "version": "4.1.0#0"
        }
    ]
}